#include <ESP8266WiFi.h>
#include <espnow.h>
#include <DHT.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

#define DHT_PIN D4
#define DHT_TYPE DHT11
#define LED_PIN D0
const int sensorPin = A0;

uint8_t gatewayMAC[] = {0xA8, 0x42, 0xE3, 0xAB, 0x6E, 0x94};

typedef struct struct_message {
  float sicaklik;
  float nem;
  int toprak_nem;
} struct_message;

struct_message gonderData;

LiquidCrystal_I2C lcd(0x27, 16, 2);
DHT dht(DHT_PIN, DHT_TYPE);

bool gonderildi = false;
bool hata = false;

void gonderimSonucu(uint8_t *mac, uint8_t durum) {
  if (durum == 0) {
    Serial.println("ESP-NOW: Gonderildi!");
    gonderildi = true;
  } else {
    Serial.println("ESP-NOW: Gonderilemedi!");
    hata = true;
  }
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, HIGH);

  Wire.begin(D2, D1);
  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("BotaniX Basliyor");
  lcd.setCursor(0, 1);
  lcd.print("ESP-NOW Modu");
  delay(2000);

  dht.begin();

  WiFi.mode(WIFI_STA);
  WiFi.disconnect();

  if (esp_now_init() != 0) {
    Serial.println("ESP-NOW baslatılamadı!");
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("ESP-NOW Hatasi!");
    return;
  }

  esp_now_set_self_role(ESP_NOW_ROLE_CONTROLLER);
  esp_now_register_send_cb(gonderimSonucu);
  esp_now_add_peer(gatewayMAC, ESP_NOW_ROLE_SLAVE, 1, NULL, 0);

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("ESP-NOW Hazir!");
  lcd.setCursor(0, 1);
  lcd.print("Gateway bulundu");
  delay(2000);

  Serial.println("ESP-NOW hazir!");
}

void loop() {
  // LED işlemleri callback yerine burada
  if (gonderildi) {
    for (int i = 0; i < 2; i++) {
      digitalWrite(LED_PIN, LOW);
      delay(100);
      digitalWrite(LED_PIN, HIGH);
      delay(100);
    }
    gonderildi = false;
  }

  if (hata) {
    for (int i = 0; i < 5; i++) {
      digitalWrite(LED_PIN, LOW);
      delay(50);
      digitalWrite(LED_PIN, HIGH);
      delay(50);
    }
    hata = false;
  }

  int ham = analogRead(sensorPin);
  int toprak = map(ham, 1024, 200, 0, 100);
  toprak = constrain(toprak, 0, 100);

  float sicaklik = dht.readTemperature();
  float nem = dht.readHumidity();

  if (isnan(sicaklik) || isnan(nem)) {
    Serial.println("DHT11 hatasi!");
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("DHT11 Hatasi!");
    lcd.setCursor(0, 1);
    lcd.print("Kablo kontrol et");
    delay(2000);
    return;
  }

  gonderData.sicaklik = sicaklik;
  gonderData.nem = nem;
  gonderData.toprak_nem = toprak;

  esp_now_send(gatewayMAC, (uint8_t*)&gonderData, sizeof(gonderData));

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("S:");
  lcd.print(sicaklik, 1);
  lcd.print("C Nem:");
  lcd.print((int)nem);
  lcd.print("%");
  lcd.setCursor(0, 1);
  lcd.print("Toprak Nem: %");
  lcd.print(toprak);

  Serial.println("----------------------------");
  Serial.print("Sicaklik  : "); Serial.print(sicaklik); Serial.println(" C");
  Serial.print("Hava Nemi : %"); Serial.println(nem);
  Serial.print("Toprak    : %"); Serial.println(toprak);
  Serial.println("----------------------------");

  delay(5000);
}
